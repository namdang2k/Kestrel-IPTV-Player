<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- ExoPlayer WAKE_MODE_NETWORK: wake + Wi-Fi lock while playing. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Xtream servers and IPTV streams are mostly plain http on arbitrary hosts; Android 9+ blocks that by default. -->
    <application android:usesCleartextTraffic="true">
        <!-- Pro menu's Picture in picture; merged into Unity's own activity entry. -->
        <activity android:name="com.unity3d.player.UnityPlayerActivity"
            android:supportsPictureInPicture="true"
            tools:node="merge" />
    </application>
</manifest>
